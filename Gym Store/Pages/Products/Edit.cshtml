@page
@model Gym_Store.Pages.Products.EditModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<form method="post" enctype="multipart/form-data">
    <input asp-for="Product.Id" type="hidden" />

    <div class="border p-4 mt-4 bg-light">
        <div class="row pb-2">
            <h2 class="text-custom py-2">Edit Product</h2>
            <hr />
        </div>

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3 row">
            <label asp-for="Product.Name" class="col-form-label"></label>
            <input asp-for="Product.Name" class="form-control custom-input" />
            <span asp-validation-for="Product.Name" class="text-danger"></span>
        </div>

        <div class="mb-3 row">
            <label asp-for="Product.CategoryId" class="col-form-label"></label>
            <select asp-for="Product.CategoryId" class="form-control custom-input" asp-items="Model.CategoryList">
                <option value="">-- Select Category --</option>
            </select>
            <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
        </div>

        <div class="mb-3 row">
            <label asp-for="Product.Quantity" class="col-form-label"></label>
            <input asp-for="Product.Quantity" class="form-control custom-input" />
            <span asp-validation-for="Product.Quantity" class="text-danger"></span>
        </div>

        <div class="mb-3 row">
            <label asp-for="Product.ServingSize" class="col-form-label"></label>
            <input asp-for="Product.ServingSize" class="form-control custom-input" />
            <span asp-validation-for="Product.ServingSize" class="text-danger"></span>
        </div>

        <div class="mb-3 row">
            <label asp-for="Product.Price" class="col-form-label"></label>
            <input asp-for="Product.Price" class="form-control custom-input" />
            <span asp-validation-for="Product.Price" class="text-danger"></span>
        </div>

        <div class="mb-3 row">
            <label class="col-form-label">Upload New Image</label>
            <input type="file" name="ImageFile" class="form-control custom-input" />
            <small class="form-text text-muted">Current image: @Model.Product.ImageUrl</small>
        </div>

        <div class="row">
            <div class="col-6 col-md-3 mb-2">
                <button type="submit" class="btn btn-custom form-control">Update</button>
            </div>
            <div class="col-6 col-md-3 mb-2">
                <a asp-page="/Products/Index" class="btn btn-secondary form-control">Back to List</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .btn-custom {
        background-color: #ff7043;
        color: white;
        border: none;
        border-radius: 20px;
        padding: 0.5rem 1rem;
        transition: background-color 0.2s ease;
    }

        .btn-custom:hover {
            background-color: #f4511e;
        }

    .text-custom {
        color: #006064;
    }

    .custom-input {
        border-radius: 10px;
    }
</style>
