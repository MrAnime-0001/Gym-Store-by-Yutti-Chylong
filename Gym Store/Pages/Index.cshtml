@page
@model Gym_Store.Pages.IndexModel
@{
    ViewData["Title"] = "Home - Gym_Store";
}

<style>
    /* Body: soft cyan gradient */
    body {
        background: linear-gradient(to right, #e0f7fa, #b2ebf2);
    }

    /* Category header */
    h2.category-title {
        color: #ff7043;
        border-bottom: 2px solid #ff7043;
        padding-bottom: 0.5rem;
        margin-bottom: 1rem;
    }

    /* Table styling */
    .product-table {
        width: 100%;
        border-collapse: collapse;
        background-color: #fff8e1;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        border-radius: 10px;
        overflow: hidden;
    }

        .product-table th,
        .product-table td {
            padding: 1rem;
            text-align: center;
            border: 1px solid #ffe0b2;
        }

        .product-table th {
            background-color: #ffe0b2;
            color: #3e2723;
        }

        .product-table td {
            background-color: #fffde7;
            color: #3e2723;
        }

    /* Product image */
    .product-img {
        max-height: 80px;
        object-fit: contain;
    }

    /* Purchase button: deep orange */
    .btn-success {
        background-color: #ff7043;
        border-color: #ff7043;
        border-radius: 20px;
        padding: 0.4rem 1rem;
        transition: background-color 0.2s ease;
        color: white;
    }

        .btn-success:hover {
            background-color: #f4511e;
            border-color: #f4511e;
        }

    /* Main heading accent */
    h1.page-title {
        color: #006064;
    }
</style>

<h1 class="page-title text-center mb-5">💪 Our Products by Category 💪</h1>

<div class="container">
    @foreach (var categoryGroup in Model.ProductsByCategory)
    {
        <h2 class="category-title">@categoryGroup.Key</h2>
        <div class="table-responsive mb-5">
            <table class="product-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in categoryGroup.Value)
                    {
                        <tr>
                            <td>
                                <img src="@product.ImageUrl" alt="@product.Name" class="img-fluid product-img" />
                            </td>
                            <td>@product.Name</td>
                            <td>$@product.Price</td>
                            <td>@product.Quantity</td>
                            <td>
                                <button class="btn btn-success" onclick="showPurchaseAlert('@product.Name')">Purchase</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        function showPurchaseAlert(productName) {
            toastr.success(`Pretend purchased "${productName}"!`);
        }
    </script>
}
