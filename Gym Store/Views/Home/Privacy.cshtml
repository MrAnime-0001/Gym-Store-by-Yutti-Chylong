@{
    ViewData["Title"] = "Privacy";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewData["Title"] - Gym_Store</title>

    <style>
        /* Body: soft cyan gradient */
        body {
            background: linear-gradient(to right, #e0f7fa, #b2ebf2);
            font-family: Arial, sans-serif;
        }

        /* Main heading accent */
        h1.page-title {
            color: #006064;
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        /* Privacy text styling */
        .privacy-text {
            background-color: #fff8e1;
            padding: 1.5rem;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            color: #3e2723;
        }
    </style>
</head>
<body>

    <div class="container mt-4">
        <h1 class="page-title">@ViewData["Title"]</h1>

        <div class="privacy-text">
            <p>This website was created by <strong>Yutti Vong Chylong</strong>. All rights reserved.</p>
        </div>
    </div>

</body>
</html>
