@model IEnumerable<Gym_Store.Models.Category>

<div class="container">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Category List</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Create" class="btn btn-custom">
                <i class="bi bi-plus-circle"></i> Create New Category
            </a>
        </div>
    </div>

    <table class="table table-bordered table-striped mt-3">
        <thead class="thead-custom">
            <tr>
                <th>Category Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var category in Model.OrderBy(c => c.Name))
                {
                    <tr>
                        <td>@category.Name</td>
                        <td>
                            <div class="btn-group" role="group">
                                <!-- Edit Button -->
                                <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <!-- Delete Button -->
                                <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash-fill"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2" class="text-center text-danger">No categories available</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    body {
        background: linear-gradient(to right, #e0f7fa, #b2ebf2);
    }

    .container h2 {
        color: #ff7043 !important;
    }

    .btn-custom {
        background-color: #ff7043;
        border-color: #ff7043;
        border-radius: 20px;
        padding: 0.5rem 1.5rem;
        color: white;
        font-weight: bold;
    }

        .btn-custom:hover {
            background-color: #f4511e;
            border-color: #f4511e;
        }

    .thead-custom {
        background-color: #ffe0b2;
        color: #3e2723;
    }

    table.table-bordered {
        border-color: #ff7043;
    }

        table.table-bordered th,
        table.table-bordered td {
            border-color: #ff7043;
        }

    table.table-striped tbody tr:nth-child(odd) {
        background-color: #fff3e0;
    }

    table.table-striped tbody tr:nth-child(even) {
        background-color: #ffecb3;
    }

    /* Custom Button Group Styling */
    .btn-group {
        display: flex;
        gap: 5px;
    }

        .btn-group .btn {
            border-radius: 8px;
        }

    /* Add some spacing around the table for better readability */
    .table {
        margin-top: 20px;
    }

    /* Add hover effect on table rows */
    table tbody tr:hover {
        background-color: #f4f4f4;
    }
</style>
