@model Gym_Store.Models.Order

<h2>Receipt</h2>
<p><strong>Order Date:</strong> @Model.OrderDate.ToLocalTime()</p>
<p><strong>Total Amount:</strong> $@Model.TotalAmount</p>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@item.Quantity</td>
                <td>$@item.Price</td>
                <td>$@(item.Quantity* item.Price)</td>
            </tr>
        }
    </tbody>
</table>

<div class="text-center mt-4">
    <a href="/" class="btn btn-primary">Go Back to Home</a>
</div>
