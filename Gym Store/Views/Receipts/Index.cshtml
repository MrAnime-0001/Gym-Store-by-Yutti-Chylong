@model IEnumerable<Gym_Store.Models.Order>
@{
    ViewData["Title"] = "Receipts";
}

<h2>Receipts</h2>

<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Total</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderDate.ToLocalTime().ToShortDateString()</td>
                <td>@order.TotalAmount.ToString("C")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@order.Id">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>
    