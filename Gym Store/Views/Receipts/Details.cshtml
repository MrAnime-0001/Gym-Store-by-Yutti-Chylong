@model Gym_Store.Models.Order
@{
    ViewData["Title"] = "Receipt Details";

    // This should be passed from the controller for admin views
    string purchaserEmail = ViewData["PurchaserEmail"] as string;
    var user = User.Identity;
    bool isAdminView = !string.IsNullOrEmpty(purchaserEmail);
}

<h2>Receipt Details</h2>

@if (isAdminView)
{
    <p><strong>Purchaser Email:</strong> @purchaserEmail</p>
}

<p><strong>Date:</strong> @Model.OrderDate.ToLocalTime().ToShortDateString()</p>
<p><strong>Total:</strong> @Model.TotalAmount.ToString("C")</p>

<h4>Items</h4>
<table class="product-table hover-highlight">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.Product?.Name</td>
                <td>@item.Quantity</td>
                <td>@item.Price.ToString("C")</td>
                <td>@(item.Quantity* item.Price).ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

<a class="btn btn-success" asp-action="Index">Back to Receipts</a>
<a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Go to Home</a>

<style>
    .hover-highlight {
        transition: box-shadow 0.3s ease, transform 0.3s ease;
        border-radius: 12px;
    }

        .hover-highlight:hover {
            box-shadow: 0 8px 24px rgba(255, 112, 67, 0.3);
            transform: scale(1.01);
        }

    .product-table {
        width: 100%;
        border-collapse: collapse;
        background-color: #fff8e1;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        border-radius: 10px;
        overflow: hidden;
        margin: 0 auto 2rem auto;
    }

        .product-table th,
        .product-table td {
            padding: 1rem;
            text-align: center;
            border: 1px solid #ffe0b2;
            vertical-align: middle;
            transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
        }

        .product-table th {
            background-color: #ffe0b2;
            color: #3e2723;
        }

        .product-table td {
            background-color: #fffde7;
            color: #3e2723;
        }

        .product-table tbody tr {
            transition: background-color 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;
        }

            .product-table tbody tr:hover {
                background-color: #fff3e0;
                transform: scale(1.005);
                box-shadow: 0 6px 16px rgba(255, 112, 67, 0.2);
                cursor: pointer;
            }

                .product-table tbody tr:hover td {
                    border-color: #ffab91;
                }

    .btn-danger {
        background-color: #d9534f;
        border-color: #d43f3a;
        border-radius: 20px;
        padding: 0.25rem 0.75rem;
        transition: background-color 0.2s ease, box-shadow 0.2s ease;
        color: white;
    }

        .btn-danger:hover {
            background-color: #c9302c;
            border-color: #ac2925;
            box-shadow: 0 0 8px rgba(201, 48, 44, 0.3);
        }

    .btn-success {
        background-color: #ff7043;
        border-color: #ff7043;
        border-radius: 20px;
        padding: 0.5rem 1.5rem;
        transition: background-color 0.2s ease, box-shadow 0.2s ease;
        color: white;
        margin-right: 0.5rem;
    }

        .btn-success:hover {
            background-color: #f4511e;
            border-color: #f4511e;
            box-shadow: 0 0 10px rgba(244, 81, 30, 0.3);
        }
</style>
